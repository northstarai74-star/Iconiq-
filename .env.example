# ---------------------------------------------------------------------------
# Every integration below is OPTIONAL. With no .env at all the site still
# builds and runs: booking falls back to a phone/email CTA and the gallery
# falls back to curated static images.
# ---------------------------------------------------------------------------

# Square Bookings API -- https://developer.squareup.com/docs/bookings-api
# Scopes needed: APPOINTMENTS_READ, APPOINTMENTS_WRITE, ITEMS_READ, CUSTOMERS_WRITE
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "sandbox" | "production"
SQUARE_ENVIRONMENT=sandbox

# Unsplash API -- https://unsplash.com/documentation
# Server-side only. 50 req/hr in demo mode, 1000/hr once approved.
UNSPLASH_ACCESS_KEY=

# Wikimedia Commons -- no API key needed, used automatically when
# UNSPLASH_ACCESS_KEY is absent. Commons files are CC-licensed, so the gallery
# renders author + licence credits; that attribution is legally required.
# Wikimedia asks API clients to identify themselves:
WIKIMEDIA_USER_AGENT=

# Set to 1 to skip Commons entirely and go straight to local placeholders.
DISABLE_WIKIMEDIA=

# Used for absolute URLs in JSON-LD / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
